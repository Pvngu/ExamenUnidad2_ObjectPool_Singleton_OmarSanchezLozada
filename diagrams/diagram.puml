@startuml diagram
' Clases
class Room {

roomNumber: number
status: RoomStatus
constructor(roomNumber: number)
reset(): void
getInfo(): string
}
enum RoomStatus {
AVAILABLE = "Disponible"
OCCUPIED = "Ocupada"
MAINTENANCE = "En Mantenimiento"
}

class Hotel {

instance: Hotel {static}
availableRooms: Room[]
usedRooms: Set<Room>
poolSize: number
constructor(totalRooms: number)
getInstance(totalRooms: number): Hotel {static}
acquireRoom(): Room | null
releaseRoom(room: Room): void
printStatus(): void
}
class Main {

main(): void
}
' Relaciones
Hotel "1" o-- "*" Room : manages >
Main ..> Hotel : uses
Main ..> Room : uses
RoomStatus <|-- Room : status : RoomStatus

' Notas y estilo
note right of Hotel
Patrón: Singleton

La instancia se guarda en instance
getInstance(totalRooms) inicializa la primera vez
end note
@enduml